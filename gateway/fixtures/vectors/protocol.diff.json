  {
   "name": "a coin whose position closed leaves net_exposure",
   "input": {
    "collection": "wallets",
    "steps": [
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {
        "BTC": 100,
        "ETH": -50
       }
      }
     },
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {
        "BTC": 100
       }
      }
     },
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {}
      }
     }
    ]
   },
   "expected": {
    "states": [
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {
        "BTC": 100,
        "ETH": -50
       }
      }
     },
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {
        "BTC": 100
       }
      }
     },
     {
      "w1": {
       "wallet_id": "w1",
       "n": 1,
       "net_exposure": {}
      }
     }
    ],
    "changed": [
     true,
     true,
     true
    ]
   }
  },
